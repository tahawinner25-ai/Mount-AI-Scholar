    "@tailwindcss/vite": "^4.0.0",
    "@types/file-saver": "^2.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "firebase": "^11.3.1",
    "framer-motion": "^12.4.7",
    "html2pdf.js": "^0.10.2",
